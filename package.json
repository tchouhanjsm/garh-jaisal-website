{
  "name": "garh-jaisal-website-browser-tests",
  "private": true,
  "description": "Browser tests for the Garh Jaisal Haveli PHP website",
  "engines": {
    "node": ">=20 <23"
  },
  "scripts": {
    "test:e2e": "playwright test",
    "studio": "node scripts/content-studio.js",
    "pack:check": "node scripts/check-content-pack.js",
    "pack:export": "node scripts/studio/cli.js export",
    "studio:cli": "node scripts/studio/cli.js",
    "test:studio": "node tests/node/content-pack.test.js",
    "studio:start": "node tools/content-studio/start.js",
    "studio:verify": "node scripts/studio/verify-release.js",
    "studio:snapshot": "node scripts/studio/route-snapshot.js",
    "studio:inbox": "node scripts/studio/cli.js inbox",
    "studio:approve": "node scripts/studio/cli.js inbox-approve",
    "studio:ship": "node scripts/studio/cli.js ship",
    "studio:watch": "node scripts/studio/cli.js inbox-watch",
    "studio:lighthouse": "npx --yes lighthouse http://127.0.0.1:8088/ --only-categories=seo,accessibility,performance --view"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1"
  }
}
